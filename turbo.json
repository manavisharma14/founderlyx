{
  "$schema": "http://turborepo.org/schema.json",
  "tasks": {
    "generate": {
      "env": [
        "DATABASE_URL",
        "PRISMA_SCHEMA_PATH",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "NEXTAUTH_SECRET",
        "NEXTAUTH_URL",
        "OPENAI_API_KEY",
        "RESEND_API_KEY"
      ],
      "outputs": []
    },
    "build": {
      "env": [
        "DATABASE_URL",
        "PRISMA_SCHEMA_PATH",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "NEXTAUTH_SECRET",
        "NEXTAUTH_URL",
        "OPENAI_API_KEY",
        "RESEND_API_KEY"
      ],
      "dependsOn": [
        "^build",
        "^generate"
      ],
      "outputs": [
        "dist/**",
        ".next/**"
      ]
    }
  }
}
